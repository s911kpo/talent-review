{
  "name": "talent-review",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "verify:remote": "node scripts/verify-remote.mjs",
    "db:apply": "node scripts/apply-migrations.mjs",
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:rls": "vitest run tests/rls",
    "seed:gen": "node scripts/gen-fake-seed.mjs",
    "prompts:gen": "node scripts/gen-prompts.mjs",
    "db:push": "supabase db push --linked",
    "demo:provision": "node scripts/provision-demo-users.mjs",
    "demo:remove": "node scripts/provision-demo-users.mjs --remove",
    "demo:showcase": "vite --mode showcase",
    "build:showcase": "vite build --mode showcase --base /demo/ --outDir dist/demo",
    "build:site": "npm run build && npm run build:showcase",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:stress:ui": "playwright test --config playwright.stress.config.ts",
    "test:resilience": "playwright test --config playwright.resilience.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.6",
    "exceljs": "^4.4.0",
    "i18next": "^23.16.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.2.17",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jszip": "^3.10.2",
    "postcss": "^8.4.49",
    "supabase": "^2.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
